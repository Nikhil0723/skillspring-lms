PORT=8000
ORIGIN=http://localhost:3000,http://localhost:4000,http://localhost:5000
NODE_ENV=development
SOCIAL_AUTH_BRIDGE_SECRET=use_the_same_random_secret_as_the_client
DEMO_MODE=false
CLIENT_URL=http://localhost:3000

# MongoDB (local or Atlas)
DB_URL=mongodb://localhost:27017/lms

# Redis (local or Upstash)
REDIS_URL=redis://localhost:6379

ACCESS_TOKEN_SECRET=your_access_token_secret
REFRESH_TOKEN_SECRET=your_refresh_token_secret
ACCESS_TOKEN_EXPIRE=5m
REFRESH_TOKEN_EXPIRE=7d

JWT_SECRET=your_jwt_secret
JWT_EXPIRES_IN=5m
RESET_TOKEN_EXPIRE=10m

# Cloudinary
CLOUD_NAME=your_cloud_name
CLOUD_API_KEY=your_cloud_api_key
CLOUD_API_SECRET=your_cloud_api_secret

# Razorpay test mode (course prices are in INR; API amounts are in paise)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# VdoCipher
VIDEO_CIPHER_API_SECRET=your_vdocipher_api_secret
DEMO_VDOCIPHER_VIDEO_IDS=your_ready_vdocipher_video_id

# SMTP (Nodemailer / Gmail)

# PostHog event capture and read-only admin analytics
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
POSTHOG_API_HOST=https://us.posthog.com
POSTHOG_PROJECT_ID=
POSTHOG_PERSONAL_API_KEY=


